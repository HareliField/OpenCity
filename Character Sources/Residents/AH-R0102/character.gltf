03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63],"name":"Fay March","extras":{"persona":{"residentId":"AH-R0102","personId":"AH-R0102","name":"Fay March","age":78,"occupation":"Retired seamstress","home":"the streets around Foundry Lofts","episode":"Ten fingers","biography":"stories/residents/01/11-ten-fingers.md#ah-r0102","life":"Fay sewed wedding dresses for women who had opinions and mothers who had more. She trained herself to hear the quietest voice in the fitting room. Now that family speaks softly around her she would rather they raise a cheerful racket. People around the window at Night Shift Donuts know Fay by a small Monday habit. Fay knows when the going-home crowd and the coming-to-work crowd will both be there.","voice":"I am the birthday girl. Everybody has taken to speaking softly around me. I asked for ten colors because I wanted to hear them quarrel over something cheerful.","appearance":"Fay has a softly rounded chin under sharp cheekbones. Look for silver temples and a dark fringe. On an ordinary day, the familiar outfit is a mustard canvas overshirt with a printed handkerchief folded into the pocket. In conversation Fay looks at people's hands before looking at what they carry.","personality":"Fay often says yes too quickly out of pride in being useful. The people closest to Fay have learned to ask again the next morning, when the answer is more likely to account for sleep.","agenda":"To hear her friends argue and laugh over the ten colors.","family":"Ivy Perreault is Fay’s younger relative by marriage. Fay puts the kettle on. Ivy chooses the music. The cups come out before either brings up the reason for the visit. They trust a difficult conversation more if it has had an ordinary beginning. Asked about *The second dog*, Ivy says, “I took the first report and wrote brown. The little girl gave me nine different browns to choose from.”","connections":"Suki Mossman (longtime nail technician). The birthday woman has trusted these hands with every difficult appointment since her husband died.","familyIds":["AH-R0183"],"connectionIds":["AH-R0101"],"reactions":[{"situation":"The birthday woman asks for five minutes by herself","response":"Fay lets the room empty and puts the next invitation in her hands.","asWritten":"The birthday woman asks for five minutes by herself. Fay lets the room empty and puts the next invitation in her hands."},{"situation":"A witness is embarrassed about remembering only a little","response":"Fay writes down their exact words with room left for uncertainty and gives them back to check.","asWritten":"A witness is embarrassed about remembering only a little. Fay writes down their exact words with room left for uncertainty and gives them back to check."},{"situation":"When two people ask for the same hour","response":"Fay rings both of them before quietly counting on somebody else to fill in.","asWritten":"When two people ask for the same hour, Fay rings both of them before quietly counting on somebody else to fill in."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_bob02","skin":0},{"mesh":7,"name":"Cloth_shirt","skin":0},{"mesh":8,"name":"Cloth_jeans","skin":0},{"mesh":9,"name":"Cloth_boots","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_female","age_old","muscle_min","height_tall","face_nose_width_decr","face_nose_length_incr","face_nose_height_decr","face_jaw_width_decr","face_chin_decr","face_cheekbones_incr","face_eye_size_decr","face_eye_spacing_incr","face_eye_tilt_decr","face_lips_decr","face_mouth_width_incr","face_ear_size_incr","face_forehead_decr","blink_left","blink_right","corr_gender_female__age_old","corr_gender_female__muscle_min"]},"weights":[0.0752,0.95,0.0546,0.3877,0.1091,0.3829,0.1864,0.0383,0.1267,0.1119,0.3525,0.0285,0.3756,0.4262,0.0943,0.2021,0.1468,0,0,0.07144,0.00411],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46},{"POSITION":47,"NORMAL":48}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_female","age_old","muscle_min","height_tall","face_nose_width_decr","face_nose_length_incr","face_nose_height_decr","