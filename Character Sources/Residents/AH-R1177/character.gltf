03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63,64],"name":"Ruben King","extras":{"persona":{"residentId":"AH-R1177","personId":"AH-R1177","name":"Ruben King","age":21,"occupation":"Conservatory student","home":"the streets around Foundry Lofts","episode":"The understudy sings","biography":"stories/residents/08/13-the-understudy-sings.md#ah-r1177","life":"“I still remember buying a concert seat I had no business pretending was cheap.” People around Breakwater Way know Ruben by a small Monday habit. Ruben stops on the landward side of the cycle track to watch the first boats turn for home.","voice":"I spent my student loan on a ticket to hear the original singer. I stayed for the new one.","appearance":"On an ordinary day, look for a charcoal zip cardigan and a replacement button a shade darker than the others. Ruben has a long face and high cheekbones, with a cropped cut that shows the shape of the ears. Ruben raises one eyebrow long before saying yes during a conversation.","personality":"Ruben is fond of ambitious ideas and deeply suspicious of grand openings. The question Ruben asks at any launch is who has the keys for cleaning up a month later.","agenda":"To hear the full show even after the casting change.","family":"Scout Hull is Ruben’s cousin. Ruben sets the time to leave. Scout picks the meeting place. It lets them stay close without turning a family visit into the loss of an entire day. They have both had stretches when that distinction mattered. Asked about *Summer staff*, Scout says, “I rented a room through September and my final lifeguard check comes in August.”","connections":"Aria Miller. A listener who bought a ticket for one voice hears the sibling's harmony with another.","familyIds":["AH-R0821"],"connectionIds":["AH-R1176"],"reactions":[{"situation":"The understudy is offered the lead before the announcement","response":"Ruben asks that the lead singer hear the change directly before it is advertised.","asWritten":"The understudy is offered the lead before the announcement. Ruben asks that the lead singer hear the change directly before it is advertised."},{"situation":"A coworker arrives late after a night at the hospital","response":"Ruben asks them privately what can be shared about the delay and respects the answer.","asWritten":"A coworker arrives late after a night at the hospital. Ruben asks them privately what can be shared about the delay and respects the answer."},{"situation":"If offered a ceremonial role","response":"Ruben accepts only after finding out whether the person doing the regular work can come too.","asWritten":"If offered a ceremonial role, Ruben accepts only after finding out whether the person doing the regular work can come too."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_short02","skin":0},{"mesh":7,"name":"Cloth_jacket","skin":0},{"mesh":8,"name":"Cloth_tshirt","skin":0},{"mesh":9,"name":"Cloth_jeans","skin":0},{"mesh":10,"name":"Cloth_boots","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["weight_max","muscle_min","height_short","face_nose_width_incr","face_nose_length_incr","face_nose_height_incr","face_jaw_width_decr","face_chin_decr","face_cheekbones_incr","face_eye_size_decr","face_eye_spacing_decr","face_eye_tilt_incr","face_lips_incr","face_mouth_width_incr","face_ear_size_incr","face_forehead_incr","blink_left","blink_right","corr_weight_max__muscle_min"]},"weights":[0.0334,0.348,0.0274,0.4277,0.0914,0.5191,0.3709,0.2373,0.2124,0.5385,0.4688,0.0929,0.0998,0.5247,0.301,0.2881,0,0,0.01162],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44}]}]},{"name":"Eyebrows","extras":{"targetNames":["weight_max","muscle_min","height_short","face_nose_width_incr","face_nose_length_incr","face_nose_height_incr","face_jaw_width_decr","face_chin_decr","face_cheekbones_incr","face_eye_size_decr","face_eye_spacing_decr","face_eye_tilt_incr","face_lips_incr","face_mouth_width_incr","face_ear_size_incr","face_forehead_incr","blink_left","blink_right","corr_weight_max__muscle_min"]},"weights":[0.0334,0.348,0.0274,0.4277,0.0914,0.5191,0.3709,0.2373,0.2124,0.5385,0.4688,0.0929,0.0998,