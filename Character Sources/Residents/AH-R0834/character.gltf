03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63],"name":"Charlie Starr","extras":{"persona":{"residentId":"AH-R0834","personId":"AH-R0834","name":"Charlie Starr","age":39,"occupation":"Spare-room decorator","home":"the blocks north of the port","episode":"A room for a father","biography":"stories/residents/06/09-a-room-for-a-father.md#ah-r0834","life":"“I still remember painting a bedroom before I knew who its owner was.” People around the downtown fountain know Charlie by a small Monday habit. Charlie keeps a little time free to hear who is playing at the far end of the park.","voice":"I painted the spare room blue. He called it a color for a nursery and I nearly sent him packing.","appearance":"Charlie has two dimples that appear only with a full smile. Look for a long plait tucked inside the collar. On an ordinary day, the familiar outfit is a pale blue work shirt with a watch on a cracked leather band. In conversation Charlie takes off the watch before a long conversation.","personality":"Charlie is fond of ambitious ideas and deeply suspicious of grand openings. The question Charlie asks at any launch is who has the keys for cleaning up a month later.","agenda":"To finish the blue room on terms the returning parent can accept.","family":"Rene Mott is Charlie’s cousin. Charlie can always ask for five minutes alone. Rene asks before bringing somebody along. It keeps a conversation between two people from unexpectedly turning into a family committee. Asked about *An unfinished atlas*, Rene says, “My hand shook the day I ruined a school register with too much water.”","connections":"Sonia Garza. Preparing a bedroom competes with the guest's own need for occasional space in the house.","familyIds":["AH-R0062"],"connectionIds":["AH-R0837"],"reactions":[{"situation":"A sibling leaves the room during the welcome dinner","response":"Charlie leaves the departing sibling room to get out without turning supper into a vote.","asWritten":"A sibling leaves the room during the welcome dinner. Charlie leaves the departing sibling room to get out without turning supper into a vote."},{"situation":"The last bus leaves while an elderly stranger is still crossing toward it","response":"Charlie asks the stranger who will be expecting them, then helps find a way to tell that person.","asWritten":"The last bus leaves while an elderly stranger is still crossing toward it. Charlie asks the stranger who will be expecting them, then helps find a way to tell that person."},{"situation":"If offered a ceremonial role","response":"Charlie accepts only after finding out whether the person doing the regular work can come too.","asWritten":"If offered a ceremonial role, Charlie accepts only after finding out whether the person doing the regular work can come too."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_short02","skin":0},{"mesh":7,"name":"Cloth_shirt","skin":0},{"mesh":8,"name":"Cloth_jeans","skin":0},{"mesh":9,"name":"Cloth_boots","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_female","age_old","weight_min","muscle_min","height_tall","face_nose_width_decr","face_nose_length_decr","face_nose_height_decr","face_jaw_width_decr","face_chin_incr","face_cheekbones_decr","face_eye_size_incr","face_eye_spacing_decr","face_eye_tilt_decr","face_lips_incr","face_mouth_width_incr","face_ear_size_decr","face_forehead_decr","blink_left","blink_right","corr_gender_female__age_old","corr_weight_min__muscle_min","corr_gender_female__muscle_min","corr_gender_female__weight_min"]},"weights":[0.3537,0.1458,0.0313,0.2469,0.1278,0.4303,0.2423,0.1965,0.3395,0.2274,0.0944,0.4323,0.2687,0.4473,0.2782,0.353,0.1161,0.4335,0,0,0.05157,0.00773,0.08733,0.01107],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46},{"POSITION":47,"NORMAL":48},{"POSITION":49,"NORMAL":50},{"POSITION":51,"NORMAL":52},{"POSITION":53,"NORMAL":54}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_female","age_old","weight_min","muscle_min","height_tall","face_nose_width_decr","face_nose_length_decr","face_nose_height_decr","face_jaw_width_decr","face_ch