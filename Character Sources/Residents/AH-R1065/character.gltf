03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63],"name":"Bianca Gallagher","extras":{"persona":{"residentId":"AH-R1065","personId":"AH-R1065","name":"Bianca Gallagher","age":55,"occupation":"Rail worker","home":"Old Town","episode":"Land without cranes","biography":"stories/residents/08/02-land-without-cranes.md#ah-r1065","life":"“I still remember one detour adding a whole hour to an easy shift.” Friday often includes a stop at the entrance to the Wash House, where Bianca stops for local notices even on a day without a load to wash.","voice":"I work the rail siding. Moving the warehouse shifts half my day onto the road.","appearance":"Bianca has short, uneven waves that refuse to lie flat, a softly rounded chin under sharp cheekbones, and a favorite piece of clothing, a sand-colored linen shirt. It usually goes with a pen clipped inside the neckline. When somebody else has the floor, Bianca folds a paper napkin into quarters without noticing.","personality":"Likes beautiful, unnecessary things and gets cross with people who mistake poverty for a lack of taste. Bianca takes longer choosing a cheap birthday card than an expensive coat.","agenda":"To protect workable freight access.","family":"Essie Good is Bianca’s younger cousin. Bianca is allowed to ask about the bad news afterward. Essie calls about good news first. Neither wants every family conversation to begin with a bill, a diagnosis or an apology. Asked about *Two portions*, Essie says, “The spare portion is mine. I go home before the register calls me a resident and come back before breakfast.”","connections":"Bailey Sato. A rail route and an old wall give the retired shareholder something tangible to show the grandson. Also in the story is Lars James (warehouse trainee).","familyIds":["AH-R0132"],"connectionIds":["AH-R1066","AH-R1061"],"reactions":[{"situation":"A developer brings a drawing of the finished offices","response":"Bianca asks where existing workers are shown in the finished picture.","asWritten":"A developer brings a drawing of the finished offices. Bianca asks where existing workers are shown in the finished picture."},{"situation":"A stranger waves a phone camera in a crying person's face","response":"Bianca asks the person crying whether they want to go somewhere quieter, leaving them control over the next step.","asWritten":"A stranger waves a phone camera in a crying person's face. Bianca asks the person crying whether they want to go somewhere quieter, leaving them control over the next step."},{"situation":"When a relative dismisses a little luxury","response":"Bianca asks which ordinary pleasure the relative would give up first.","asWritten":"When a relative dismisses a little luxury, Bianca asks which ordinary pleasure the relative would give up first."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_short04","skin":0},{"mesh":7,"name":"Cloth_shirt","skin":0},{"mesh":8,"name":"Cloth_jeans","skin":0},{"mesh":9,"name":"Cloth_shoes","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_female","age_old","weight_min","muscle_max","height_short","face_nose_width_incr","face_nose_length_decr","face_nose_height_decr","face_jaw_width_decr","face_chin_decr","face_eye_size_decr","face_eye_spacing_decr","face_eye_tilt_decr","face_lips_decr","face_mouth_width_decr","face_ear_size_decr","face_forehead_decr","blink_left","blink_right","corr_gender_female__age_old","corr_weight_min__muscle_max","corr_gender_female__muscle_max","corr_gender_female__weight_min"]},"weights":[0.5096,0.4792,0.6233,0.2216,0.1065,0.0885,0.0935,0.3535,0.0512,0.4247,0.4065,0.0316,0.3722,0.2267,0.2467,0.4971,0.1071,0,0,0.2442,0.13812,0.11293,0.31763],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46},{"POSITION":47,"NORMAL":48},{"POSITION":49,"NORMAL":50},{"POSITION":51,"NORMAL":52}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_female","age_old","weight_min","muscle_max","height_short","face_nose_width_incr","face_nose_length_decr","face_nose_height_decr","face_jaw_width_decr","face_chin_decr","face_eye_size_decr","face_eye_spacing_decr","fa