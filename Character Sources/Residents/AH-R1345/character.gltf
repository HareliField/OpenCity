03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63],"name":"Denise Xu","extras":{"persona":{"residentId":"AH-R1345","personId":"AH-R1345","name":"Denise Xu","age":38,"occupation":"Adult daughter and typist","home":"Old Town","episode":"The missing name on the stern","biography":"stories/residents/09/15-the-missing-name-on-the-stern.md#ah-r1345","life":"“I still remember getting two official letters addressed to two versions of me.” People around the foot of Harbor Viaduct know Denise by a small Tuesday habit. Denise pauses where the machinery overhead makes two people stand close enough to hear each other.","voice":"I am the daughter with both spellings on my documents. A boat sign is the one place I can choose.","appearance":"On an ordinary day, look for a narrow-striped sweater and a thin silver ring worn on a cord. Denise has a broad nose and a deep dimple on one cheek, with black hair twisted into a small knot. Denise gathers both sleeves neatly before settling in during a conversation.","personality":"Denise enjoys bargaining, including over things already settled. It is partly a joke and partly a test of whether the other person feels able to say no.","agenda":"To choose which personal spelling goes on the boat.","family":"Leon Osei is Denise’s second cousin. Denise knows which ones can be shared. Leon keeps the photographs. They enjoy remembering people in public and also know what it feels like to have a private afternoon turned into an anecdote for strangers. Asked about *The late crossing*, Leon says, “I have the furthest walk to the pickup. The others moved their tea break by eight minutes for me.”","connections":"Jo Graves. The buyer gives the person who lives under two names a say in which one sails.","familyIds":["AH-R0866"],"connectionIds":["AH-R1343"],"reactions":[{"situation":"The apprentice notices the missing letter on the stern","response":"Denise checks the intended spelling with the family before painting over anything.","asWritten":"The apprentice notices the missing letter on the stern. Denise checks the intended spelling with the family before painting over anything."},{"situation":"Somebody says a missing friend must be avoiding their calls","response":"Denise suggests one straightforward message without accusations and gives the friend time to answer.","asWritten":"Somebody says a missing friend must be avoiding their calls. Denise suggests one straightforward message without accusations and gives the friend time to answer."},{"situation":"When a friend starts agreeing too quickly","response":"Denise puts the deal away and suggests a walk.","asWritten":"When a friend starts agreeing too quickly, Denise puts the deal away and suggests a walk."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_bob01","skin":0},{"mesh":7,"name":"Cloth_hoodie","skin":0},{"mesh":8,"name":"Cloth_jeans","skin":0},{"mesh":9,"name":"Cloth_shoes","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_female","age_old","weight_min","height_tall","face_nose_width_incr","face_nose_length_decr","face_nose_height_decr","face_jaw_width_decr","face_chin_incr","face_eye_size_decr","face_eye_spacing_incr","face_eye_tilt_incr","face_lips_decr","face_mouth_width_incr","face_ear_size_decr","face_forehead_decr","blink_left","blink_right","corr_gender_female__age_old","corr_gender_female__weight_min"]},"weights":[0.8654,0.125,0.5653,0.0809,0.0581,0.1993,0.3427,0.1701,0.1537,0.1115,0.5123,0.0251,0.5137,0.4599,0.1178,0.042,0,0,0.10817,0.48921],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_female","age_old","weight_min","height_tall","face_nose_width_incr","face_nose_length_decr","face_nose_height_decr","face_jaw_width_decr","face_chin_incr","face_eye_size_decr","face_eye_spacing_incr","face_eye_tilt_incr","face_lips_decr","face_mouth_width_incr","face_ear_size_decr","face_forehead_decr","blink_left","blink_right","corr_gender_female__age_old","corr_gender_female__weight_min"]},"weights":[0.8654,0.125,0.5653,0.0809,0.0581,0.1993,0.3427,0.1701,0.1537,0.1