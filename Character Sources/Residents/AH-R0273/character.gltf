03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63],"name":"Wesley Carr","extras":{"persona":{"residentId":"AH-R0273","personId":"AH-R0273","name":"Wesley Carr","age":16,"occupation":"Student interpreter","home":"Old Town","episode":"The quiet verse","biography":"stories/residents/02/13-the-quiet-verse.md#ah-r0273","life":"“I signed prayers with Gran long before I could spell their opening words.” On Friday, near the window at Night Shift Donuts, Wesley knows when the going-home crowd and the coming-to-work crowd will both be there.","voice":"I signed the words so my sister could follow. She saw the withheld verse in my hands at rehearsal.","appearance":"Wesley has auburn hair cut square at the nape, a broad nose and a deep dimple on one cheek, and a favorite piece of clothing, a faded indigo overshirt. It usually goes with a replacement button a shade darker than the others. When somebody else has the floor, Wesley presses the lips together to keep a smile in.","personality":"Wesley has a talent for getting adversaries to laugh at exactly the same thing. Wesley knows better than to expect the laugh to settle what they are arguing about.","agenda":"To agree with the writer which signs may appear at the show.","family":"Gavin Roche is Wesley’s first cousin once removed. Wesley puts the kettle on. Gavin chooses the music. The cups come out before either brings up the reason for the visit. They trust a difficult conversation more if it has had an ordinary beginning. Asked about *The guarantee*, Gavin says, “I processed the loan in six minutes and spent an hour telling the family how that was possible.”","connections":"Maeve Hamm. Signing in the pause makes room for a listener who heard the fountain underneath it.","familyIds":["AH-R1073"],"connectionIds":["AH-R0278"],"reactions":[{"situation":"The silent verse gets applause in the wrong place","response":"Wesley gives the singer time to resume instead of trying to conduct the applause.","asWritten":"The silent verse gets applause in the wrong place. Wesley gives the singer time to resume instead of trying to conduct the applause."},{"situation":"A coworker arrives late after a night at the hospital","response":"Wesley takes one immediate task off their hands and asks when they want to tell the supervisor.","asWritten":"A coworker arrives late after a night at the hospital. Wesley takes one immediate task off their hands and asks when they want to tell the supervisor."},{"situation":"When people declare an argument over too soon","response":"Wesley asks them to describe one concrete thing that will be different tomorrow.","asWritten":"When people declare an argument over too soon, Wesley asks them to describe one concrete thing that will be different tomorrow."}]},"appearanceSource":"photo measurements and biography"}},{"mesh":6,"name":"Hair_short04","skin":0},{"mesh":7,"name":"Cloth_shirt","skin":0},{"mesh":8,"name":"Cloth_jeans","skin":0},{"mesh":9,"name":"Cloth_shoes","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_male","age_child","weight_min","muscle_min","height_short","face_nose_width_decr","face_nose_length_incr","face_nose_height_incr","face_jaw_width_incr","face_chin_incr","face_cheekbones_incr","face_eye_size_decr","face_eye_tilt_incr","face_lips_decr","face_mouth_width_incr","face_ear_size_incr","face_forehead_decr","blink_left","blink_right","corr_gender_male__age_child","corr_weight_min__muscle_min","corr_gender_male__muscle_min","corr_gender_male__weight_min"]},"weights":[0.85,0.3333,0.092,0.2372,0.0409,0.2311,0.1689,0.0166,0.1929,0.5619,0.4324,0.0299,0.3129,0.5878,0.135,0.4189,0.4973,0,0,0.2833,0.02182,0.20162,0.0782],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46},{"POSITION":47,"NORMAL":48},{"POSITION":49,"NORMAL":50},{"POSITION":51,"NORMAL":52}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_male","age_child","weight_min","muscle_min","height_short","face_nose_width_decr","face_nose_length_incr","face_nose_height_incr","face_jaw_width_incr","face_chin_incr","face_cheekbones_incr","face_eye_size_decr","face_eye_tilt_incr","face_lips_decr