03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63],"name":"Faye Tran","extras":{"persona":{"residentId":"AH-R1026","personId":"AH-R1026","name":"Faye Tran","age":54,"occupation":"Dance instructor","home":"the western residential streets","episode":"A dance for two fathers","biography":"stories/residents/07/13-a-dance-for-two-fathers.md#ah-r1026","life":"“I still remember teaching a man whose shoes were still white from a bakery shift.” People around Paper & Pine Books know Faye by a small Monday habit. Faye starts with the handwritten shelf cards and often leaves with a suggestion for somebody else.","voice":"I trained both men on separate nights. Neither wanted the other to know how scared he was.","appearance":"Faye has one cheek that creases before the other. Look for a high puff tied with plain cord. On an ordinary day, the familiar outfit is a black overshirt with pearl buttons with one cuff folded back twice. In conversation Faye listens with the head tilted a little to the left.","personality":"Faye is good at starting things, dreadful at waiting for them to take effect. Close family can tell how worried Faye is by the number of tiny errands suddenly being done.","agenda":"To help the fathers rehearse without rivalry.","family":"Sam Kaur is Faye’s younger cousin. Faye can stop the walk at any corner. Sam chooses the familiar route. Walking side by side makes it easier to disagree without turning each disagreement into a contest. Asked about *Low water music*, Sam says, “I miss my first language most when somebody asks me to name a thing.”","connections":"Agnes Lin. The choreographer and dance teacher work out where each father has room to move.","familyIds":["AH-R0229"],"connectionIds":["AH-R1021"],"reactions":[{"situation":"One of the fathers misses the dance rehearsal","response":"Faye keeps the missed step available for a quiet practice before the ceremony.","asWritten":"One of the fathers misses the dance rehearsal. Faye keeps the missed step available for a quiet practice before the ceremony."},{"situation":"An envelope of wages is found under a café chair","response":"Faye asks the cashier to hold it and lets a claimant identify the writing and amount privately.","asWritten":"An envelope of wages is found under a café chair. Faye asks the cashier to hold it and lets a claimant identify the writing and amount privately."},{"situation":"When asked to wait without intervening","response":"Faye agrees on a check-in time and keeps busy somewhere out of sight.","asWritten":"When asked to wait without intervening, Faye agrees on a check-in time and keeps busy somewhere out of sight."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_short04","skin":0},{"mesh":7,"name":"Cloth_shirt","skin":0},{"mesh":8,"name":"Cloth_jeans","skin":0},{"mesh":9,"name":"Cloth_boots","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_female","age_old","weight_max","muscle_max","height_tall","face_nose_width_incr","face_nose_length_decr","face_nose_height_incr","face_jaw_width_decr","face_chin_incr","face_cheekbones_incr","face_eye_size_incr","face_eye_spacing_incr","face_eye_tilt_decr","face_lips_decr","face_mouth_width_decr","face_ear_size_incr","face_forehead_decr","blink_left","blink_right","corr_gender_female__age_old","corr_weight_max__muscle_max","corr_gender_female__muscle_max","corr_gender_female__weight_max"]},"weights":[0.3034,0.4583,0.1323,0.5252,0.2791,0.2793,0.0566,0.0423,0.1246,0.3798,0.0998,0.1121,0.0172,0.4075,0.0239,0.1105,0.2751,0.415,0,0,0.13905,0.06948,0.15935,0.04014],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46},{"POSITION":47,"NORMAL":48},{"POSITION":49,"NORMAL":50},{"POSITION":51,"NORMAL":52},{"POSITION":53,"NORMAL":54}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_female","age_old","weight_max","muscle_max","height_tall","face_nose_width_incr","face_nose_length_decr","face_nose_height_incr","face_jaw_width_decr","face_chin_incr","face_cheekbones_incr","face_eye_size_incr","face_eye_spacing_incr","face_eye_tilt_decr","face_lips_decr","face_mouth_width_decr","face_ear_s