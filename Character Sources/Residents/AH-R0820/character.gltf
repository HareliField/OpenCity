03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63],"name":"Eden Song","extras":{"persona":{"residentId":"AH-R0820","personId":"AH-R0820","name":"Eden Song","age":38,"occupation":"Bookkeeper","home":"the streets around Foundry Lofts","episode":"Reading the payslip","biography":"stories/residents/06/07-reading-the-payslip.md#ah-r0820","life":"“I still remember finding my father's pension stamp book behind his wedding photograph.” People around the foot of Harbor Viaduct know Eden by a small Wednesday habit. Eden pauses where the machinery overhead makes two people stand close enough to hear each other.","voice":"I found a pension contribution and called my father. I wanted the first money conversation we've ever got through without fighting.","appearance":"Eden has short sandy hair and a marked widow's peak, full cheeks and a mouth that pulls slightly to one side, and a favorite piece of clothing, a narrow-striped sweater. It usually goes with a partly rubbed-away embroidered initial. When somebody else has the floor, Eden looks at people's hands before looking at what they carry.","personality":"Eden thinks best while walking. Sitting beneath someone's office clock makes Eden sound more certain than they feel, an effect close friends have learned to distrust.","agenda":"To talk to the father about the newly found pension contribution.","family":"Teal Holmes is Eden’s older cousin. Eden knows which ones can be shared. Teal keeps the photographs. They enjoy remembering people in public and also know what it feels like to have a private afternoon turned into an anecdote for strangers. Asked about *The sheltered corner*, Teal says, “I found a ring under the old shelter. The date inside matches a couple who used to catch separate buses.”","connections":"Frances Finch. A missed class and a rediscovered pension both lead to calls made after work.","familyIds":["AH-R0270"],"connectionIds":["AH-R0819"],"reactions":[{"situation":"An employer asks who is attending the class","response":"Eden protects the attendance list and offers general information about the class.","asWritten":"An employer asks who is attending the class. Eden protects the attendance list and offers general information about the class."},{"situation":"An envelope of wages is found under a café chair","response":"Eden brings the envelope to the counter unopened and stays long enough to make a note of who accepted it.","asWritten":"An envelope of wages is found under a café chair. Eden brings the envelope to the counter unopened and stays long enough to make a note of who accepted it."},{"situation":"When family demands an immediate answer","response":"Eden asks them to walk to the corner together and listen until the corner comes.","asWritten":"When family demands an immediate answer, Eden asks them to walk to the corner together and listen until the corner comes."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_short04","skin":0},{"mesh":7,"name":"Cloth_hoodie","skin":0},{"mesh":8,"name":"Cloth_jeans","skin":0},{"mesh":9,"name":"Cloth_boots","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_male","age_old","weight_max","muscle_min","height_tall","face_nose_length_incr","face_jaw_width_decr","face_chin_incr","face_cheekbones_incr","face_eye_size_decr","face_eye_spacing_decr","face_eye_tilt_incr","face_lips_incr","face_mouth_width_decr","face_ear_size_decr","face_forehead_incr","blink_left","blink_right","corr_gender_male__age_old","corr_weight_max__muscle_min","corr_gender_male__muscle_min","corr_gender_male__weight_max"]},"weights":[0.2424,0.125,0.2112,0.2691,0.2544,0.0221,0.033,0.2715,0.7,0.4715,0.1934,0.205,0.4067,0.4474,0.2968,0.3167,0,0,0.0303,0.05683,0.06523,0.05119],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46},{"POSITION":47,"NORMAL":48},{"POSITION":49,"NORMAL":50}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_male","age_old","weight_max","muscle_min","height_tall","face_nose_length_incr","face_jaw_width_decr","face_chin_incr","face_cheekbones_incr","face_eye_size_decr","face_eye_spacing_decr","face_eye_tilt_