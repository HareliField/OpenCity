03578186],"scale":[1,0.9999999403953552,1.0000001192092896],"translation":[-9.484210750088096e-09,0.40733101963996887,-2.0954757928848267e-09]},{"children":[48],"name":"calf_r","rotation":[0.058844517916440964,-0.2321772277355194,0.008530084043741226,0.9708544611930847],"scale":[0.9999998807907104,0.9999997615814209,0.9999999403953552],"translation":[-5.587935447692871e-09,0.39470696449279785,7.450580596923828e-09]},{"children":[49],"name":"thigh_r","rotation":[-0.958074688911438,0.09174000471830368,-0.2139034867286682,0.16709880530834198],"scale":[0.9999998211860657,0.9999999403953552,0.9999985098838806],"translation":[-0.10147152096033096,-0.003829043358564377,-0.010990308597683907]},{"children":[42,46,50],"name":"pelvis","rotation":[0.5305899977684021,-1.5553862193127784e-16,-3.88809262563683e-10,0.8476285934448242],"translation":[0,-0.013216575607657433,0.8744488954544067]},{"children":[51],"name":"Root","rotation":[-0.7071067690849304,0,0,0.7071067690849304],"translation":[0,-0.0005625183694064617,6.100162863731384e-08]},{"mesh":0,"name":"Body","skin":0},{"mesh":1,"name":"Eyebrows","skin":0},{"mesh":2,"name":"Eyelashes","skin":0},{"mesh":3,"name":"Eyes","skin":0},{"mesh":4,"name":"Teeth","skin":0},{"mesh":5,"name":"Tongue","skin":0},{"children":[53,54,55,56,57,58,52,60,61,62,63,64],"name":"Lennon Ahmed","extras":{"persona":{"residentId":"AH-R0750","personId":"AH-R0750","name":"Lennon Ahmed","age":31,"occupation":"Family liaison and marine clerk","home":"the western residential streets","episode":"A boat for sale twice","biography":"stories/residents/05/15-a-boat-for-sale-twice.md#ah-r0750","life":"“I still remember answering two parents' letters on the same sheet.” People around the brick passage off the shop row know Lennon by a small Wednesday habit. Lennon takes the longer way when the smell from the ovens reaches the pavement.","voice":"I answered both numbers. It was the first time our separated parents had asked me the same question all year.","appearance":"Lennon is easy to recognize by auburn hair cut square at the nape and a heart-shaped face and prominent ears. Usually dressed in an olive canvas jacket with a fabric zip pull cut from a school scarf, Lennon draws breath as if to speak and lets someone else go first when listening.","personality":"Lennon loves an audience until a private hurt enters the room. Then the performer disappears and someone very good at getting other people through a door takes over.","agenda":"To let both parents hear the same answer.","family":"Sadie Breen is Lennon’s stepsibling. Lennon keeps the photographs. Sadie knows which ones can be shared. They enjoy remembering people in public and also know what it feels like to have a private afternoon turned into an anecdote for strangers. Asked about *A widow bids again*, Sadie says, “I was the original landlady's granddaughter.”","connections":"Sasha Wong (parent). The parent who wrote the wrong number finally gets the same question answered by the child.","familyIds":["AH-R0922"],"connectionIds":["AH-R0741"],"reactions":[{"situation":"A buyer wants the old name painted over immediately","response":"Lennon checks who owns the name before anyone comes down with a paint tin.","asWritten":"A buyer wants the old name painted over immediately. Lennon checks who owns the name before anyone comes down with a paint tin."},{"situation":"A stranger offers money to cut ahead of an exhausted neighbor","response":"Lennon asks the neighbor privately what they want, without treating their place as something for sale.","asWritten":"A stranger offers money to cut ahead of an exhausted neighbor. Lennon asks the neighbor privately what they want, without treating their place as something for sale."},{"situation":"If a stranger asks to hear a private story","response":"Lennon offers one about their own embarrassment instead.","asWritten":"If a stranger asks to hear a private story, Lennon offers one about their own embarrassment instead."}]},"appearanceSource":"biography casting design"}},{"mesh":6,"name":"Hair_bob02","skin":0},{"mesh":7,"name":"Cloth_jacket","skin":0},{"mesh":8,"name":"Cloth_tshirt","skin":0},{"mesh":9,"name":"Cloth_jeans","skin":0},{"mesh":10,"name":"Cloth_boots","skin":0}],"meshes":[{"name":"base","extras":{"targetNames":["gender_female","weight_min","muscle_min","height_tall","face_nose_width_decr","face_nose_length_incr","face_nose_height_incr","face_jaw_width_incr","face_chin_incr","face_cheekbones_decr","face_eye_size_incr","face_eye_spacing_incr","face_eye_tilt_incr","face_lips_incr","face_ear_size_incr","face_forehead_incr","blink_left","blink_right","corr_weight_min__muscle_min","corr_gender_female__muscle_min","corr_gender_female__weight_min"]},"weights":[0.384,0.6579,0.0868,0.1262,0.3472,0.1145,0.2561,0.2258,0.57,0.2648,0.4823,0.0177,0.269,0.2797,0.78,0.1288,0,0,0.05711,0.03333,0.25263],"primitives":[{"attributes":{"POSITION":2,"NORMAL":3,"TEXCOORD_0":4,"JOINTS_0":5,"WEIGHTS_0":6},"indices":1,"material":0,"targets":[{"POSITION":7,"NORMAL":8},{"POSITION":9,"NORMAL":10},{"POSITION":11,"NORMAL":12},{"POSITION":13,"NORMAL":14},{"POSITION":15,"NORMAL":16},{"POSITION":17,"NORMAL":18},{"POSITION":19,"NORMAL":20},{"POSITION":21,"NORMAL":22},{"POSITION":23,"NORMAL":24},{"POSITION":25,"NORMAL":26},{"POSITION":27,"NORMAL":28},{"POSITION":29,"NORMAL":30},{"POSITION":31,"NORMAL":32},{"POSITION":33,"NORMAL":34},{"POSITION":35,"NORMAL":36},{"POSITION":37,"NORMAL":38},{"POSITION":39,"NORMAL":40},{"POSITION":41,"NORMAL":42},{"POSITION":43,"NORMAL":44},{"POSITION":45,"NORMAL":46},{"POSITION":47,"NORMAL":48}]}]},{"name":"Eyebrows","extras":{"targetNames":["gender_female","weight_min","muscle_min","height_tall","face_nose_width_decr","face_nose_length_incr","face_nose_height_incr","face_jaw_width_incr","face_chin_incr","face_cheekbones_decr","face_eye_size_incr","face_eye_spacing_incr","face_eye_tilt_incr","face_lips_incr","face_ear_size_incr","face_forehead_incr","blink_left","blink_right","corr_weight_min__m